{
  "name": "reel-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agente que produce reels verticales educativos con HUD holográfico (guion con Claude, voz con ElevenLabs, render con Remotion).",
  "type": "module",
  "scripts": {
    "reel": "tsx agent/index.ts",
    "studio": "remotion studio remotion/index.ts",
