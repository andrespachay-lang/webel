# Obligatoria: escribe el guion con Claude
ANTHROPIC_API_KEY=

# Opcional: voz en off + subtítulos sincronizados palabra por palabra.
# Sin ella el reel sale sin narración (subtítulos con tiempos estimados).
ELEVENLABS_API_KEY=
# Voz de ElevenLabs (id). Por defecto "George".
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Opcional: ruta a Chrome/Chromium headless si Remotion no puede descargar el suyo.
# REMOTION_BROWSER=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell

# Opcional: genera los clips de video con IA vía fal.ai (Veo 3, Kling, Seedance…).
FAL_KEY=
# Modelo de video (por defecto fal-ai/veo3/fast). Ej.: fal-ai/kling-video/v2.1/master/text-to-video
FAL_VIDEO_MODEL=
# Parámetros extra en JSON para el modelo de video. Ej.: {"resolution":"1080p"}
FAL_VIDEO_ARGS=
# Modelo de imagen para --visuals image (por defecto fal-ai/flux-pro/v1.1-ultra)
FAL_IMAGE_MODEL=
